{
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh pr close *)",
      "Bash(gh repo *)",
      "Bash(gh api *)",
      "Bash(gh issue *)",
      "Bash(gh release *)",
      "Bash(gh secret *)",
      "Bash(gh workflow *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --delete *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh pr review *)",
      "PowerShell(gh pr close *)",
      "PowerShell(gh repo *)",
      "PowerShell(gh api *)",
      "PowerShell(gh issue *)",
      "PowerShell(gh release *)",
      "PowerShell(gh secret *)",
      "PowerShell(gh workflow *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push --delete *)",
      "PowerShell(git branch -d *)",
      "PowerShell(git branch -D *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_git.py\"",
            "timeout": 15,
            "statusMessage": "Checking git and gh rules"
          }
        ]
      }
    ]
  }
}
